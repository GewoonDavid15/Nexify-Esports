# Copy to .env locally, or (preferred) set these as platform secrets.
# NEVER commit real values. Configure ONE provider.

# --- Option A: Resend (HTTPS API) ---
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL="Nexify Website <website@your-verified-domain.com>"

# --- Option B: SMTP ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# CONTACT_FROM_EMAIL="Nexify Website <website@your-domain.com>"

# Optional
# CONTACT_TO_EMAIL=          # defaults to PUBLIC_CONTACT_EMAIL in src/config.js
# FORM_SECRET=               # long random string; keeps open forms valid across restarts
# TRUST_PROXY=1              # set when running behind one reverse proxy (most hosts)
# PUBLIC_SITE_URL=https://example.com
# PORT=3000
